<file path="src/app/tela-matriz-treinamento/matriz-treinamento.html">
<div class="matriz-container">
  
  <header class="matriz-header">
    <h2>Matriz de Treinamentos</h2>
    @switch (cardSelecionado) {
      @case ('Visão Geral') {
        <button class="sst-btn sst-btn--dark" (click)="exportarMatriz()">
          Exportar Matriz
        </button>
      }
      @case ('LNT / Cargos') {
        <button class="sst-btn sst-btn--dark" (click)="navegarParaCadastro()">
          Novo LNT / Cargo
        </button>
      }
      @case ('Treinamentos') {
        <button class="sst-btn sst-btn--dark" (click)="navegarParaCadastro()">
          Novo Treinamento
        </button>
      }
      @case ('Certificações') {
        <button class="sst-btn sst-btn--dark" (click)="abrirModalCertificacao()">
          Vincular Certificação
        </button>
      }
      @case ('Reciclagens') {
        <div class="matriz-header-actions">
          <button class="sst-btn sst-btn--dark" (click)="navegarParaCadastro()">
            Nova Reciclagem
          </button>
          <button class="sst-btn sst-btn--dark" (click)="abrirModalReciclagem()">
            Vincular Reciclagem
          </button>
        </div>
      }
    }
  </header>

  
  <section class="cards-grid">
    @for (card of resumos; track card.titulo) {
      <div class="card-summary"
           [class.card-summary--active]="cardSelecionado === card.titulo"
           (click)="selecionarCard(card.titulo)">
        <span class="card-summary__title">{{ card.titulo }}</span>
        @if (card.total !== undefined) {
          <strong class="card-summary__val">{{ card.total }}</strong>
        } @else {
          <strong class="card-summary__val card-summary__val--icon">{{ card.icone }}</strong>
        }
      </div>
    }
  </section>

  
  <div class="tables-column">
    
