              <tr>
                <th>Colaborador</th>
                <th>Cargo</th>
                <th class="text-center">NR-06 (EPI)</th>
                <th class="text-center">NR-11 (Empilhadeira)</th>
                <th class="text-center">NR-12 (Máquinas)</th>
                <th class="text-center">NR-17 (Ergonomia)</th>
                <th class="text-center">NR-35 (Altura)</th>
                <th scope="col" class="sst-text-right">Ações</th>
              </tr>
            </thead>
            <tbody>
              @for (row of matrizCruzada; track row.colaborador) {
                <tr>
                  <td><strong>{{ row.colaborador }}</strong></td>
                  <td>{{ row.cargo }}</td>
                  <td class="text-center">
                    <span class="badge" [ngClass]="row.nr06 === 'N/A' ? 'badge--na' : 'badge--' + row.nr06.toLowerCase()">{{ row.nr06 }}</span>
                  </td>
                  <td class="text-center">
                    <span class="badge" [ngClass]="row.nr11 === 'N/A' ? 'badge--na' : 'badge--' + row.nr11.toLowerCase()">{{ row.nr11 }}</span>
                  </td>
                  <td class="text-center">
                    <span class="badge" [ngClass]="row.nr12 === 'N/A' ? 'badge--na' : 'badge--' + row.nr12.toLowerCase()">{{ row.nr12 }}</span>
                  </td>
                  <td class="text-center">
                    <span class="badge" [ngClass]="row.nr17 === 'N/A' ? 'badge--na' : 'badge--' + row.nr17.toLowerCase()">{{ row.nr17 }}</span>
                  </td>
                  <td class="text-center">
                    <span class="badge" [ngClass]="row.nr35 === 'N/A' ? 'badge--na' : 'badge--' + row.nr35.toLowerCase()">{{ row.nr35 }}</span>
                  </td>
                  <td class="sst-text-right">
                    <button type="button" class="sst-btn-link" (click)="abrirModalEdicaoGeral(row)">Editar</button>
                  </td>
                </tr>
              }
            </tbody>
          </table>
