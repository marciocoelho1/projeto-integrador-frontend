    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: var(--cor-borda);
    transition: .3s;
    border-radius: 34px;

    &:before {
      position: absolute;
      content: "";
      height: 18px; width: 18px;
      left: 3px; bottom: 3px;
      background-color: white;
      transition: .3s;
      border-radius: 50%;
    }
  }

  input:checked + &__slider { background-color: var(--cor-primaria); }
  input:checked + &__slider:before { transform: translateX(20px); }
}
