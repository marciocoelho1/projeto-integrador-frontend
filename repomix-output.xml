<file path="src/styles.scss">
/* =======================================================
   1. IMPORTAÇÃO DAS FONTES (Google Fonts)
   ======================================================= */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;700&display=swap');

/* =======================================================
   2. DESIGN TOKENS (Baseados no Painel SST)
   ======================================================= */
:root {
  
  --cor-fundo-app: #e2e8f0;          
  --cor-fundo-card: #ffffff;
  --cor-primaria: #0f172a;           
  --cor-borda: #cbd5e1;
  
  
  --cor-texto-principal: #1e293b;
  --cor-texto-secundario: #64748b;
  
  
  --cor-tabela-header: #d1d5db;      
  --cor-alerta: #dc2626;             
  --cor-link: #2563eb;               
  --cor-link-hover: #1d4ed8;

  
  --fonte-titulos: 'JetBrains Mono', monospace;
  --fonte-corpo: 'Inter', sans-serif;
}

/* =======================================================
   3. RESET E CONFIGURAÇÕES BASE
   ======================================================= */
html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100vh;
}

body {
  font-family: var(--fonte-corpo);
  color: var(--cor-texto-principal);
  background-color: var(--cor-fundo-app);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

input, button, select, textarea, label {
  font-family: var(--fonte-corpo);
}

/* =======================================================
   4. TIPOGRAFIA GLOBAL
   ======================================================= */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--fonte-titulos);
  color: var(--cor-primaria);
  font-weight: 700;
  margin-top: 0;
}

p, span, li {
  font-family: var(--fonte-corpo);
  color: var(--cor-texto-principal);
}

/* =======================================================
   5. CLASSES ESTRUTURAIS DE PÁGINA E CABEÇALHO
   ======================================================= */
.sst-layout {
  max-width: 1200px;
  margin: 0 auto;
}

.sst-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 2rem;

  &__main {
    font-size: 2.25rem;
    color: var(--cor-primaria);
    margin: 0;
    letter-spacing: -0.02em; 
  }

  &__breadcrumb {
    color: var(--cor-texto-secundario);
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }
}

/* =======================================================
   6. COMPONENTES GLOBAIS (Cards, Tabelas, Buscas e Botões)
   ======================================================= */
.sst-card {
  background: var(--cor-fundo-card);
  border-radius: 8px;
  border: 1px solid var(--cor-borda);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  padding: 1.5rem;

  &--form { max-width: 800px; }

  &__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  &__title {
    font-size: 1.25rem;
    margin: 0;
    color: var(--cor-primaria);
  }

  &__subtitle {
    color: var(--cor-texto-secundario);
    font-size: 0.9rem;
    margin: 0.25rem 0 2rem;
  }
}

.sst-search__input, .sst-select {
  padding: 0.6rem 1rem;
  border: 1px solid var(--cor-borda);
  border-radius: 4px;
  font-size: 0.9rem;
  width: 280px;
  outline: none;

  &:focus { border-color: var(--cor-primaria); }
}

.sst-table {
  width: 100%;
  border-collapse: collapse;

  th {
    background-color: var(--cor-tabela-header);
    color: var(--cor-primaria);
    font-weight: 700;
    text-align: left;
    padding: 1rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  td {
    padding: 1rem;
    border-bottom: 1px solid var(--cor-borda);
    font-size: 0.9rem;
    vertical-align: middle;

    strong {
      display: block;
      color: var(--cor-texto-principal);
      font-weight: 600;
    }
  }

  &__subtext {
    display: block;
    font-size: 0.75rem;
    color: var(--cor-texto-secundario);
    margin-top: 0.25rem;
  }
}

.sst-badge {
  padding: 0.25rem 0.75rem;
  border-radius: 12px;
  font-size: 0.75rem;
  font-weight: 600;
  background: #f1f5f9;
  color: #475569;

  &--ativo { background: #dcfce7; color: #166534; }
  &--inativo { background: #fce8e6; color: #d93025; }
  &--afastado { background: #fef7e0; color: #b07d00; }
  &--grupo { background: #e0e7ff; color: #3730a3; }
}

.sst-btn {
  padding: 0.65rem 1.25rem;
  border-radius: 4px;
  font-weight: 600;
  font-family: var(--fonte-corpo);
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.2s;
  font-size: 0.9rem;

  &--dark {
    background: var(--cor-primaria);
    color: #fff;
    &:hover { background: #000; }
  }

  &--outline {
    background: transparent;
    border-color: var(--cor-primaria);
    color: var(--cor-primaria);
    &:hover { background: #f8fafc; }
  }
}

.sst-btn-link {
  background: none;
  border: none;
  color: var(--cor-link);
  font-weight: 600;
  cursor: pointer;
  text-decoration: underline;
  &:hover { color: var(--cor-link-hover); }
}


.sst-pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1.5rem;
  margin-top: 1rem;

  &__info {
    font-size: 0.85rem;
    color: var(--cor-texto-secundario);
  }

  &__controls {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
}

.sst-btn-page {
  background: transparent;
  border: 1px solid var(--cor-borda);
  padding: 0.4rem 0.8rem;
  border-radius: 4px;
  font-size: 0.85rem;
  color: var(--cor-texto-principal);
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover:not(:disabled) {
    background-color: var(--cor-tabela-header);
  }

  &--active {
    background-color: var(--cor-primaria);
    color: #ffffff;
    border-color: var(--cor-primaria);
  }

  &:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
}


.sst-text-right { text-align: right; }
.sst-text-center { text-align: center; }

/* =========================================
   ESTRUTURA DOS MODAIS (OVERLAY + CARD)
   ========================================= */
.sst-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  padding: 1rem;
  animation: fadeIn 0.2s ease-out forwards;
}

.sst-modal {
  width: 100%;
  max-width: 600px;
  background: #ffffff;
  border-radius: 12px;
  padding: 1.5rem 2rem;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  max-height: 90vh;
  overflow-y: auto;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}


/* =========================================
   RESPONSIVIDADE GLOBAL (SGSST)
   ========================================= */

@media (max-width: 992px) {
  
  .sst-layout {
    padding: 1rem 0;
  }

  .sst-header {
    flex-direction: column;
    align-items: flex-start !important;
    gap: 1rem;
  }

  .sst-header__main {
    font-size: 1.6rem !important;
  }

  
  .sst-grid, 
  .sst-form-grid, 
  .cards-grid, 
  .charts-grid,
  .content-grid {
    grid-template-columns: 1fr !important;
  }

  .sst-col-span-2 {
    grid-column: span 1 !important;
  }

  
  .sst-search {
    width: 100%;
    flex-direction: column;
    
    .sst-search__input {
      width: 100% !important;
    }
    
    button {
      width: 100%;
    }
  }

  .sst-card__toolbar {
    flex-direction: column;
    align-items: flex-start !important;
    gap: 1rem;
  }
}



.sst-table-wrapper {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: 8px;
  
  
  .sst-table {
    min-width: 700px; 
  }
}
</file>

<file path="src/app/tela-configuracoes/configuracoes.html">
<div class="sst-layout">
  <header class="sst-header">
    <hgroup class="sst-header__titles">
      <p class="sst-header__breadcrumb">SGSST / Administração</p>
      <h1 class="sst-header__main">Configurações do Sistema</h1>
    </hgroup>
    
    <button type="button" class="sst-btn sst-btn--dark" (click)="actionNovoUsuario()">
      Cadastrar Novo Usuário
    </button>
  </header>

  <nav class="sst-nav" role="tablist" aria-label="Guias de Configuração">
    @for (guia of guiasNavegacao; track guia.id) {
      <button
        type="button"
        role="tab"
        class="sst-nav__item"
        [class.sst-nav__item--active]="guiaAtual() === guia.id"
        [attr.aria-selected]="guiaAtual() === guia.id"
        (click)="navegarGuia(guia.id)"
      >
        {{ guia.titulo }}
      </button>
    }
  </nav>

  <section class="sst-content">
    @switch (guiaAtual()) {
      
      
      @case ('usuarios') {
        <section class="sst-card" aria-labelledby="titulo-usuarios">
          <header class="sst-card__toolbar">
            <h2 id="titulo-usuarios" class="sst-card__title">Gestão de Usuários</h2>
            <search class="sst-search">
              <input 
                type="text" 
                class="sst-search__input" 
                style="width: 380px;" 
                placeholder="Buscar por nome, CPF/matrícula, grupo ou status..."
                [value]="termoBusca()" 
                (input)="termoBusca.set($any($event.target).value)" 
                aria-label="Buscar usuário" 
              />
            </search>
          </header>

          <table class="sst-table">
            <thead>
              <tr>
                <th scope="col">Usuário</th>
                <th scope="col">CPF / Matrícula</th>
                <th scope="col">Grupo de Acesso</th>
                <th scope="col">Status</th>
                <th scope="col" class="sst-text-right">Ações</th>
              </tr>
            </thead>
            <tbody>
              @for (usuario of usuariosFiltrados(); track usuario.id) {
                <tr>
                  <td>
                    <strong>{{ usuario.nomeCompleto }}</strong>
                    <span class="sst-table__subtext">{{ usuario.emailCorporativo }}</span>
                  </td>
                  <td>{{ usuario.cpf }}</td>
                  <td><span class="sst-badge sst-badge--grupo">{{ getNomeGrupo(usuario.grupoId) }}</span></td>
                  <td><span class="sst-badge" [class.sst-badge--ativo]="usuario.status === 'ativo'">{{ usuario.status | titlecase }}</span></td>
                  <td class="sst-text-right"><button class="sst-btn-link" (click)="actionEditarUsuario(usuario)">Editar</button></td>
                </tr>
              } @empty {
                <tr>
                  <td colspan="5" class="sst-text-center" style="padding: 2.5rem 1rem; color: var(--cor-texto-secundario); font-style: italic;">
                    Nenhum usuário encontrado com o termo "{{ termoBusca() }}".
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </section>
      }

      
      @case ('grupos') {
        <div class="sst-grid">
          @for (grupo of gruposSst(); track grupo.id) {
            <article class="sst-card-group">
              <header class="sst-card-group__header">
                <h3>{{ grupo.nomenclatura }}</h3>
                <span class="sst-card-group__count">{{ grupo.modulosLiberados.length }} módulos</span>
              </header>
              <p class="sst-card-group__desc">{{ grupo.finalidade }}</p>
              <button class="sst-btn sst-btn--outline" (click)="irParaMatrizDoGrupo(grupo.id)">Ajustar Matriz</button>
            </article>
          }
        </div>
      }

      
      @case ('matriz') {
        <section class="sst-card" aria-labelledby="titulo-matriz">
          <header class="sst-card__toolbar">
            <h2 id="titulo-matriz" class="sst-card__title">Matriz de Permissões</h2>
            <select class="sst-select" [value]="grupoSelecionadoId()" (change)="grupoSelecionadoId.set($any($event.target).value)" aria-label="Selecione o grupo para editar a matriz">
              @for (grupo of gruposSst(); track grupo.id) {
                <option [value]="grupo.id">{{ grupo.nomenclatura }}</option>
              }
            </select>
          </header>

          <p class="sst-matrix-info" role="status">Você está editando as regras para: <strong>{{ grupoEmEdicao().nomenclatura }}</strong></p>

          <table class="sst-table sst-table--matrix">
            <thead>
              <tr>
                <th scope="col">Módulo do Sistema</th>
                <th scope="col">Descrição do Nível de Acesso</th>
                <th scope="col" class="sst-text-center">Permissão</th>
              </tr>
            </thead>
            <tbody>
              @for (mod of modulosDisponiveis; track mod.chave) {
                <tr>
                  <td><strong>{{ mod.titulo }}</strong></td>
                  <td>{{ mod.detalhe }}</td>
                  <td class="sst-text-center">
                    <label class="sst-switch" [attr.for]="'mod-' + mod.chave">
                      <input type="checkbox" 
                             [id]="'mod-' + mod.chave"
                             [checked]="grupoEmEdicao().modulosLiberados.includes(mod.chave)"
                             (change)="alternarAcessoModulo(mod.chave)" 
                             [attr.aria-label]="'Permitir acesso ao módulo ' + mod.titulo">
                      <span class="sst-switch__slider"></span>
                    </label>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </section>
      }

      
      @case ('globais') {
        <section class="sst-card sst-card--form" aria-labelledby="titulo-regras">
          <header>
            <h2 id="titulo-regras" class="sst-card__title">Regras de Negócio e Alertas</h2>
            <p class="sst-card__subtitle">Configure o comportamento autônomo do sistema SST.</p>
          </header>

          <form class="sst-form" (submit)="$event.preventDefault(); gravarAlteracoesGlobais()">
            <fieldset class="sst-form__list" style="border: none; padding: 0; margin: 0;">
              <legend class="visually-hidden">Configurações de Alertas do Sistema</legend>
              @for (regra of regrasAlertas(); track regra.codigo) {
                <div class="sst-form__row">
                  <div class="sst-form__text">
                    <label [attr.for]="'regra-' + regra.codigo">
                      <strong>{{ regra.nomeRegra }}</strong>
                      <span>{{ regra.descricaoRegra }}</span>
                    </label>
                  </div>
                  
                  <label class="sst-switch" [attr.for]="'regra-' + regra.codigo">
                    <input type="checkbox" 
                           [id]="'regra-' + regra.codigo"
                           [checked]="regra.isAtiva" 
                           (change)="alternarRegra(regra.codigo)" 
                           [attr.aria-label]="'Ativar regra ' + regra.nomeRegra">
                    <span class="sst-switch__slider"></span>
                  </label>
                </div>
              }
            </fieldset>

            <footer class="sst-form__actions">
              <button type="submit" class="sst-btn sst-btn--dark sst-btn--large">Salvar Configurações</button>
            </footer>
          </form>
        </section>
      }

      
      @case ('logs') {
        <section class="sst-card" aria-labelledby="titulo-logs">
          <header class="sst-card__toolbar" style="flex-wrap: wrap; gap: 1rem;">
            <h2 id="titulo-logs" class="sst-card__title">Histórico de Auditoria</h2>
            
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                <label for="data-inicio" style="font-size: 0.75rem; font-weight: 600;">Data Início</label>
                <input type="date" id="data-inicio" class="sst-search__input" 
                       [value]="filtroLogDataInicio()" 
                       (input)="filtroLogDataInicio.set($any($event.target).value)" />
              </div>

              <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                <label for="data-fim" style="font-size: 0.75rem; font-weight: 600;">Data Fim</label>
                <input type="date" id="data-fim" class="sst-search__input" 
                       [value]="filtroLogDataFim()" 
                       (input)="filtroLogDataFim.set($any($event.target).value)" />
              </div>

              <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                <label style="font-size: 0.75rem; font-weight: 600;">Pesquisar</label>
                <search class="sst-search">
                  <input type="text" class="sst-search__input" style="width: 260px;" 
                         placeholder="Usuário, módulo ou ação..."
                         [value]="filtroLogTermo()" 
                         (input)="filtroLogTermo.set($any($event.target).value)" />
                </search>
              </div>
            </div>
          </header>

          <div class="sst-table-wrapper">
            <table class="sst-table">
              <thead>
                <tr>
                  <th scope="col">Data / Hora</th>
                  <th scope="col">Usuário / Matrícula</th>
                  <th scope="col">Módulo</th>
                  <th scope="col">Ação</th>
                  <th scope="col">Detalhes</th>
                </tr>
              </thead>
              <tbody>
                @for (log of logsFiltrados(); track log.id) {
                  <tr>
                    <td style="white-space: nowrap;"><strong>{{ log.dataHora | date:'dd/MM/yyyy HH:mm' }}</strong></td>
                    <td>{{ log.usuario }}</td>
                    <td>{{ log.modulo }}</td>
                    <td>
                      <span class="sst-badge" 
                            [class.sst-badge--ativo]="log.acao === 'CRIACAO'"
                            [class.sst-badge--grupo]="log.acao === 'ACESSO'"
                            [style.background]="log.acao === 'EXCLUSAO' ? '#fef2f2' : ''"
                            [style.color]="log.acao === 'EXCLUSAO' ? '#991b1b' : ''">
                        {{ log.acao }}
                      </span>
                    </td>
                    <td>{{ log.descricao }}</td>
                  </tr>
                } @empty {
                  <tr>
                    <td colspan="5" class="sst-text-center" style="padding: 2.5rem 1rem; color: var(--cor-texto-secundario); font-style: italic;">
                      Nenhum registro de log encontrado com os filtros atuais.
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </section>
      }

    }
  </section>

  @if (mostrarModalEdicaoUsuario()) {
    @if (usuarioEmEdicao(); as usuario) {
      <div class="sst-modal-overlay">
        <div class="sst-modal sst-card" style="max-width: 600px;">
          <header class="sst-card__toolbar">
            <h3 class="sst-card__title">Editar Usuário</h3>
            <button type="button" class="sst-btn-link" (click)="fecharModalEdicaoUsuario()" style="font-size: 1.5rem; text-decoration: none;">&times;</button>
          </header>

          <form class="sst-form-grid" (submit)="$event.preventDefault(); salvarEdicaoUsuario()">
            <div class="sst-form-group sst-col-span-2">
              <label for="usr-edit-nome">Nome Completo</label>
              <input type="text" id="usr-edit-nome" class="sst-search__input sst-input-full" [(ngModel)]="usuario.nomeCompleto" name="nomeCompleto" required>
            </div>

            <div class="sst-form-group sst-col-span-2">
              <label for="usr-edit-email">E-mail Corporativo</label>
              <input type="email" id="usr-edit-email" class="sst-search__input sst-input-full" [(ngModel)]="usuario.emailCorporativo" name="emailCorporativo" required>
            </div>

            <div class="sst-form-group">
              <label for="usr-edit-cpf">CPF / Matrícula</label>
              <input type="text" id="usr-edit-cpf" class="sst-search__input sst-input-full" [(ngModel)]="usuario.cpf" name="cpf" required>
            </div>

            <div class="sst-form-group">
              <label for="usr-edit-status">Status</label>
              <select id="usr-edit-status" class="sst-search__input sst-input-full" [(ngModel)]="usuario.status" name="status" required>
                <option value="ativo">Ativo</option>
                <option value="inativo">Inativo</option>
              </select>
            </div>

            <div class="sst-form-group sst-col-span-2">
              <label for="usr-edit-grupo">Grupo de Acesso</label>
              <select id="usr-edit-grupo" class="sst-search__input sst-input-full" [(ngModel)]="usuario.grupoId" name="grupoId" required>
                @for (grupo of gruposSst(); track grupo.id) {
                  <option [value]="grupo.id">{{ grupo.nomenclatura }}</option>
                }
              </select>
            </div>

            <footer class="sst-form-actions sst-col-span-2">
              <button type="button" class="sst-btn sst-btn--outline" (click)="fecharModalEdicaoUsuario()">Cancelar</button>
              <button type="submit" class="sst-btn sst-btn--dark">Salvar Alterações</button>
            </footer>
          </form>
        </div>
      </div>
    }
  }
</div>
</file>

